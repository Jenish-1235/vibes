# ---- LLM ----
# Option A: LiteLLM proxy — set all three.
LLM_MODEL=gpt-4o
LLM_API_BASE=https://your-litellm-proxy.example.com
LLM_API_KEY=sk-...

# Option B: Azure AI Studio / Azure OpenAI — set LLM_MODEL=azure/<deployment-name>,
# leave LLM_API_BASE/LLM_API_KEY unset, and set these instead:
# LLM_MODEL=azure/gpt-4o
# AZURE_API_KEY=...
# AZURE_API_BASE=https://your-resource.openai.azure.com
# AZURE_API_VERSION=2024-08-01-preview

# ---- X API (developer.x.com → your app → Keys and tokens) ----
# App must have Read + Write (+ Direct Messages for DMs) permissions,
# and the access token must be regenerated AFTER setting those permissions.
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
